# Copy to .env for local development. Never put real secrets in Git.
HOST=127.0.0.1
PORT=3064
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/vflie
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Only enable behind WeChat CloudRun's trusted identity-injecting ingress.
# Direct HTTPS/local testing must use code2Session and leave this disabled.
TRUST_CLOUDRUN_IDENTITY=0
PLATFORM_BOOTSTRAP_LOGIN=platform-operator
PLATFORM_BOOTSTRAP_PASSWORD=replace-with-local-password
SESSION_TTL_DAYS=30
# Required for db:reset. Only set this when you intend to drop public schema.
ALLOW_DB_RESET=
